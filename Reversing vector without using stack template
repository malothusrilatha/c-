#include <iostream>
#include <vector>
using namespace std;

class VectorReverse {
    vector<int> vec;

public:
    void input() {
        int n, x;
        cout << "Enter number of elements: ";
        cin >> n;

        cout << "Enter elements: ";
        for (int i = 0; i < n; i++) {
            cin >> x;
            vec.push_back(x);
        }
    }

    void reverse() {
        int start = 0;
        int end = vec.size() - 1;

        while (start < end) {
            int temp = vec[start];
            vec[start] = vec[end];
            vec[end] = temp;
            start++;
            end--;
        }
    }

    void display() {
        for (int x : vec)
            cout << x << " ";
        cout << endl;
    }
};

int main() {
    VectorReverse obj;

    cout << "Original Vector:\n";
    obj.input();
    obj.display();

    obj.reverse();

    cout << "Reversed Vector:\n";
    obj.display();

    return 0;
}
